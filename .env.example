OPENAI_API_KEY=
OPENAI_IMAGE_IMPORT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_IMPORT_REASONING_EFFORT=low
OPENAI_IMAGE_IMPORT_PRIMARY_UPSCALE_ENABLED=true
OPENAI_IMAGE_IMPORT_PRIMARY_TARGET_SHORT_SIDE=512
OPENAI_IMAGE_IMPORT_PRIMARY_MAX_SCALE=3
OPENAI_IMAGE_IMPORT_VERIFICATION_MODEL=gpt-5.6-luna
OPENAI_IMAGE_IMPORT_VERIFICATION_REASONING_EFFORT=none
OPENAI_IMAGE_IMPORT_SEMANTIC_VERIFICATION_ENABLED=true
OPENAI_IMAGE_IMPORT_SEMANTIC_VERIFICATION_MODEL=gpt-5.6-sol
OPENAI_IMAGE_IMPORT_SEMANTIC_VERIFICATION_REASONING_EFFORT=none
OPENAI_IMAGE_IMPORT_FALLBACK_MODEL=gpt-5.6-sol
OPENAI_IMAGE_IMPORT_FALLBACK_REASONING_EFFORT=none

# Shared Discord application configuration. The Application ID is also the
# Better Auth OAuth client ID; do not add a separate DISCORD_CLIENT_ID.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_CLIENT_SECRET=

# Better Auth and the single Turso auth database. These values are server-only.
# Generate BETTER_AUTH_SECRET locally and never paste its value into logs,
# issues, chat, or committed files.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
TURSO_DATABASE_URL=libsql://ltgear-auth-YOUR_ORG.turso.io
TURSO_AUTH_TOKEN=

# Public canonical URL used in generated links. Override with
# https://ltgear.vercel.app in the Vercel Production environment.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Damage calculator origin used by the advanced gear-comparison handoff.
# Point this directly at the deployment that supports the ltgear fragment.
NUXT_PUBLIC_DAMAGE_CALCULATOR_URL=https://ltdmg.vercel.app/

# Registration-only secret. Keep this out of the deployed environment.
DISCORD_BOT_TOKEN=
